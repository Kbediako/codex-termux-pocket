#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/termux/termux-mobile-lib.sh
source "$SCRIPT_DIR/termux-mobile-lib.sh"

CODEX_SRC_DIR="${CODEX_SRC_DIR:-$HOME/codex}"
CODEX_TERMUX_FORK_URL="${CODEX_TERMUX_FORK_URL:-$CODEX_TERMUX_FORK_URL_DEFAULT}"
CODEX_TERMUX_REPO="${CODEX_TERMUX_REPO:-$CODEX_TERMUX_FORK_REPO_DEFAULT}"
CODEX_TERMUX_TIMEOUT="${CODEX_TERMUX_TIMEOUT:-7200}"
CODEX_TERMUX_POLL_SECONDS="${CODEX_TERMUX_POLL_SECONDS:-15}"
WORKFLOW_FILE="termux-mobile-artifact.yml"
MANIFEST_FILE="${CODEX_TERMUX_RELEASE_MANIFEST:-$CODEX_SRC_DIR/scripts/termux/release-manifest.env}"

operation="update"
run_id=""
expected_sha=""
explicit_expected_sha="no"
source_ref=""
dispatch="no"
install_after_wait="yes"
release_tag=""
release_version=""
release_archive_sha=""
release_archive_size=""
release_runtime_size=""
temporary_dir=""
update_lock_dir=""

usage() {
  cat <<'USAGE'
Usage:
  codex-update-alpha [update] [--timeout SECONDS] [--ref REF] [--dispatch]
  codex-update-alpha check
  codex-update-alpha wait --run-id ID [--expected-sha SHA] [--timeout SECONDS]
  codex-update-alpha install-run --run-id ID [--expected-sha SHA]
  codex-update-alpha install-release --release-tag TAG --expected-sha SHA
  codex-update-alpha list-installed
  codex-update-alpha rollback
  codex-update-alpha activate --expected-sha SHA

Normal update installs the public, verified release named by release-manifest.env.
It never rebases, commits, pushes, or builds Rust on the phone.

  check          Compare the installed runtime with the maintained release and
                 report the newest OpenAI alpha from the fetch-only upstream.
  wait           Resume a queued/running Actions run and install it on success.
  install-run    Install the complete artifact from an already-successful run.
  list-installed Show verified installed releases; the active release is marked *.
  rollback       Atomically activate the newest previous verified release.
  activate       Atomically activate an installed verified release by commit SHA.
  --dispatch     Maintainer/advanced opt-in: dispatch only when no exact matching
                 queued, running, or completed run exists.
  --timeout      Local wait limit in seconds (default: 7200). The GitHub run is
                 not cancelled when this local timeout expires.

GitHub authentication is not needed for a public release. Actions run download
requires `gh auth login` because GitHub's Actions artifact API requires it.
USAGE
}

if [[ $# -gt 0 ]]; then
  case "$1" in
    update|check|wait|install-run|install-release|list-installed|rollback|activate)
      operation="$1"
      shift
      ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-id)
      run_id="${2:-}"
      shift 2
      ;;
    --expected-sha)
      expected_sha="${2:-}"
      explicit_expected_sha="yes"
      shift 2
      ;;
    --ref)
      source_ref="${2:-}"
      shift 2
      ;;
    --timeout)
      CODEX_TERMUX_TIMEOUT="${2:-}"
      shift 2
      ;;
    --dispatch)
      dispatch="yes"
      shift
      ;;
    --no-install)
      install_after_wait="no"
      shift
      ;;
    --release-tag)
      release_tag="${2:-}"
      shift 2
      ;;
    --release-version)
      release_version="${2:-}"
      shift 2
      ;;
    --archive-sha256)
      release_archive_sha="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      termux_abort "unknown argument: $1"
      ;;
  esac
done

[[ "$CODEX_TERMUX_TIMEOUT" =~ ^[0-9]+$ && "$CODEX_TERMUX_TIMEOUT" -gt 0 ]] || \
  termux_abort '--timeout must be a positive integer.'
[[ "$CODEX_TERMUX_POLL_SECONDS" =~ ^[0-9]+$ && "$CODEX_TERMUX_POLL_SECONDS" -gt 0 ]] || \
  termux_abort 'CODEX_TERMUX_POLL_SECONDS must be a positive integer.'

cleanup() {
  if [[ -n "$temporary_dir" && -d "$temporary_dir" ]]; then
    rm -rf "$temporary_dir"
  fi
  if [[ -n "$update_lock_dir" && -d "$update_lock_dir" ]]; then
    rm -f "$update_lock_dir/pid"
    rmdir "$update_lock_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

acquire_update_lock() {
  local requested="${CODEX_TERMUX_LOCK_DIR:-$PREFIX/var/lock/codex-termux-update.lock}"
  mkdir -p "$(dirname "$requested")" || termux_abort "cannot create update lock parent: $(dirname "$requested")"
  if ! mkdir "$requested" 2>/dev/null; then
    local owner
    owner="$(cat "$requested/pid" 2>/dev/null || true)"
    termux_abort "another Codex Termux update is active${owner:+ (pid $owner)}; retry after it finishes."
  fi
  update_lock_dir="$requested"
  printf '%s
' "$$" >"$update_lock_dir/pid"
}

load_release_manifest() {
  [[ -f "$MANIFEST_FILE" ]] || return 1
  local format manifest_repo
  termux_validate_key_value_file "$MANIFEST_FILE" \
    format_version repository release_tag head_sha codex_version archive_sha256 \
    archive_size_bytes runtime_size_bytes || \
    termux_abort 'release manifest is malformed, duplicated, or contains an unknown key.'
  format="$(termux_metadata_value "$MANIFEST_FILE" format_version)"
  manifest_repo="$(termux_metadata_value "$MANIFEST_FILE" repository)"
  [[ "$format" == "1" || "$format" == "2" ]] || termux_abort "unsupported release manifest format: ${format:-missing}"
  [[ "$manifest_repo" == "$CODEX_TERMUX_REPO" ]] || \
    termux_abort "release manifest repository mismatch: ${manifest_repo:-missing}"
  release_tag="${release_tag:-$(termux_metadata_value "$MANIFEST_FILE" release_tag)}"
  expected_sha="${expected_sha:-$(termux_metadata_value "$MANIFEST_FILE" head_sha)}"
  release_version="${release_version:-$(termux_metadata_value "$MANIFEST_FILE" codex_version)}"
  release_archive_sha="${release_archive_sha:-$(termux_metadata_value "$MANIFEST_FILE" archive_sha256)}"
  release_archive_size="$(termux_metadata_value "$MANIFEST_FILE" archive_size_bytes)"
  release_runtime_size="$(termux_metadata_value "$MANIFEST_FILE" runtime_size_bytes)"
  [[ "$release_tag" =~ ^termux-v[0-9A-Za-z._-]+$ ]] || termux_abort 'release manifest contains an invalid release_tag.'
  [[ -n "$release_version" && "$release_version" != *$'\n'* ]] || termux_abort 'release manifest contains an invalid codex_version.'
  termux_validate_sha "$expected_sha" || termux_abort 'release manifest contains an invalid head_sha.'
  termux_validate_sha256 "$release_archive_sha" || termux_abort 'release manifest contains an invalid archive_sha256.'
  if [[ "$format" == "2" ]]; then
    termux_validate_positive_integer "$release_archive_size" ||       termux_abort 'release manifest contains an invalid archive_size_bytes.'
    termux_validate_positive_integer "$release_runtime_size" ||       termux_abort 'release manifest contains an invalid runtime_size_bytes.'
  fi
  return 0
}

prepare_checkout() {
  [[ -d "$CODEX_SRC_DIR/.git" ]] || termux_abort "Codex helper checkout not found at $CODEX_SRC_DIR; rerun install-codex-termux."
  if [[ "${CODEX_TERMUX_SKIP_CHECKOUT_SYNC:-0}" == "1" ]]; then
    termux_configure_remotes "$CODEX_SRC_DIR" "$CODEX_TERMUX_FORK_URL"
    CODEX_TERMUX_REPO="$(termux_remote_repo_slug "$CODEX_SRC_DIR" origin)"
    return
  fi
  [[ "$(git -C "$CODEX_SRC_DIR" branch --show-current)" == "main" ]] || \
    termux_abort "$CODEX_SRC_DIR is not on main; refusing to change branches during an update."
  [[ -z "$(git -C "$CODEX_SRC_DIR" status --porcelain)" ]] || \
    termux_abort "$CODEX_SRC_DIR has local changes; they were left untouched. Use a separate CODEX_SRC_DIR for the installer checkout."
  termux_configure_remotes "$CODEX_SRC_DIR" "$CODEX_TERMUX_FORK_URL"
  CODEX_TERMUX_REPO="$(termux_remote_repo_slug "$CODEX_SRC_DIR" origin)"
  git -C "$CODEX_SRC_DIR" fetch --prune origin main
  git -C "$CODEX_SRC_DIR" merge-base --is-ancestor HEAD origin/main || \
    termux_abort 'local main has diverged from origin/main; refusing to reset or rebase it.'
  git -C "$CODEX_SRC_DIR" merge --ff-only origin/main
}

download_public_release() {
  local base="https://github.com/${CODEX_TERMUX_REPO}/releases/download/${release_tag}"
  if [[ -n "$release_archive_size" && -n "$release_runtime_size" ]]; then
    termux_require_install_space "$PREFIX" "$release_archive_size" "$release_runtime_size"
  fi
  temporary_dir="$(mktemp -d)"
  termux_info "downloading maintained runtime $release_tag (commit $expected_sha)"
  termux_download "$base/$CODEX_TERMUX_ARCHIVE" "$temporary_dir/$CODEX_TERMUX_ARCHIVE"
  termux_download "$base/$CODEX_TERMUX_METADATA" "$temporary_dir/$CODEX_TERMUX_METADATA"
  termux_download "$base/$CODEX_TERMUX_CHECKSUMS" "$temporary_dir/$CODEX_TERMUX_CHECKSUMS"
  termux_install_verified_bundle "$temporary_dir" "$expected_sha" "$release_version" "$release_archive_sha"
}

require_gh_actions_access() {
  termux_require_command gh
  if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    termux_abort "GitHub Actions artifacts require authentication. Run 'gh auth login', then retry; public release installs do not require GitHub login."
  fi
}

resolve_source_sha() {
  local ref="${1:-origin/main}"
  local sha
  sha="$(git -C "$CODEX_SRC_DIR" rev-parse --verify "${ref}^{commit}" 2>/dev/null || true)"
  if [[ -z "$sha" ]]; then
    git -C "$CODEX_SRC_DIR" fetch --prune origin main
    sha="$(git -C "$CODEX_SRC_DIR" rev-parse --verify "${ref}^{commit}" 2>/dev/null || true)"
  fi
  termux_validate_sha "$sha" || termux_abort "cannot resolve source ref to a commit: $ref"
  printf '%s\n' "$sha"
}

list_workflow_runs() {
  gh run list --repo "$CODEX_TERMUX_REPO" --workflow "$WORKFLOW_FILE" --limit 1000 \
    --json url,headSha,status,conclusion,displayTitle \
    --template '{{range .}}{{.url}}|{{.headSha}}|{{.status}}|{{.conclusion}}|{{.displayTitle}}{{"\n"}}{{end}}' \
    | awk -F '|' '{ n = split($1, parts, "/"); print parts[n] "|" $0 }'
}

find_matching_run() {
  local sha="$1"
  list_workflow_runs | awk -F '|' -v sha="$sha" '
    $6 ~ /^Termux runtime [0-9a-f]{40}$/ {
      if ($6 == "Termux runtime " sha) { print; exit }
      next
    }
    $3 == sha { print; exit }
  '
}

show_run() {
  local id="$1"
  gh run view "$id" --repo "$CODEX_TERMUX_REPO" \
    --json url,headSha,status,conclusion,displayTitle \
    --template '{{.url}}|{{.headSha}}|{{.status}}|{{.conclusion}}|{{.displayTitle}}' \
    | awk -F '|' '{ n = split($1, parts, "/"); print parts[n] "|" $0 }'
}

run_expected_sha() {
  local line="$1"
  local title head
  head="$(cut -d '|' -f3 <<<"$line")"
  title="$(cut -d '|' -f6- <<<"$line")"
  if [[ "$title" =~ ^Termux\ runtime\ ([0-9a-f]{40})$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' "$head"
  fi
}

print_run_state() {
  local line="$1"
  local id url status conclusion
  IFS='|' read -r id url _ status conclusion _ <<<"$line"
  case "$status" in
    queued|requested|waiting|pending)
      termux_info "run $id is queued: $url"
      ;;
    in_progress)
      termux_info "run $id is running: $url"
      ;;
    completed)
      if [[ "$conclusion" == "success" ]]; then
        termux_info "run $id succeeded: $url"
      else
        termux_info "run $id failed (conclusion=${conclusion:-unknown}): $url"
      fi
      ;;
    *)
      termux_info "run $id state=${status:-unknown}: $url"
      ;;
  esac
}

download_and_install_run() {
  local id="$1"
  local wanted_sha="$2"
  local line status conclusion actual_sha
  line="$(show_run "$id")"
  print_run_state "$line"
  IFS='|' read -r _ _ _ status conclusion _ <<<"$line"
  [[ "$status" == "completed" && "$conclusion" == "success" ]] || \
    termux_abort "run $id is not a successful completed run."
  actual_sha="$(run_expected_sha "$line")"
  if [[ -n "$wanted_sha" ]]; then
    [[ "$actual_sha" == "$wanted_sha" ]] || \
      termux_abort "run commit mismatch: expected $wanted_sha, run identifies $actual_sha."
  else
    wanted_sha="$actual_sha"
  fi
  termux_validate_sha "$wanted_sha" || termux_abort 'cannot determine the exact source commit for this run; pass --expected-sha.'

  temporary_dir="$(mktemp -d)"
  gh run download "$id" --repo "$CODEX_TERMUX_REPO" \
    --name "$CODEX_TERMUX_ARTIFACT_NAME" --dir "$temporary_dir"
  termux_install_verified_bundle "$temporary_dir" "$wanted_sha"
}

wait_for_run() {
  local id="$1"
  local wanted_sha="$2"
  local started now line status conclusion last_state=""
  started="$(date +%s)"
  while true; do
    line="$(show_run "$id")"
    IFS='|' read -r _ _ _ status conclusion _ <<<"$line"
    if [[ "$status/$conclusion" != "$last_state" ]]; then
      print_run_state "$line"
      last_state="$status/$conclusion"
    fi
    if [[ "$status" == "completed" ]]; then
      [[ "$conclusion" == "success" ]] || termux_abort "workflow run $id failed with conclusion ${conclusion:-unknown}."
      if [[ "$install_after_wait" == "yes" ]]; then
        download_and_install_run "$id" "$wanted_sha"
      fi
      return 0
    fi
    now="$(date +%s)"
    if (( now - started >= CODEX_TERMUX_TIMEOUT )); then
      local url
      url="$(cut -d '|' -f2 <<<"$line")"
      printf 'codex-termux: local wait timed out after %s seconds. The GitHub run was not cancelled and may still continue.\n' "$CODEX_TERMUX_TIMEOUT" >&2
      printf 'codex-termux: resume with: codex-update-alpha wait --run-id %s --expected-sha %s\n' "$id" "${wanted_sha:-$(run_expected_sha "$line")}" >&2
      printf 'codex-termux: run URL: %s\n' "$url" >&2
      return 3
    fi
    sleep "$CODEX_TERMUX_POLL_SECONDS"
  done
}

find_dispatched_run() {
  local sha="$1"
  local started now line
  started="$(date +%s)"
  while true; do
    line="$(find_matching_run "$sha" || true)"
    if [[ -n "$line" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
    now="$(date +%s)"
    if (( now - started >= 120 )); then
      termux_abort "dispatched workflow did not appear within 120 seconds; inspect https://github.com/$CODEX_TERMUX_REPO/actions"
    fi
    sleep "$CODEX_TERMUX_POLL_SECONDS"
  done
}

update_from_actions() {
  local sha="$1"
  local line id url status conclusion
  require_gh_actions_access
  line="$(find_matching_run "$sha" || true)"
  if [[ -z "$line" ]]; then
    if [[ "$dispatch" != "yes" ]]; then
      termux_abort "no maintained public release or exact Actions run exists for $sha. A maintainer must publish one; no local source build will be attempted."
    fi
    termux_info "no matching run exists; dispatching one exact build for $sha"
    gh workflow run "$WORKFLOW_FILE" --repo "$CODEX_TERMUX_REPO" --ref main -f source_ref="$sha"
    line="$(find_dispatched_run "$sha")"
  else
    termux_info "reusing the existing exact workflow run; no duplicate was dispatched"
  fi
  IFS='|' read -r id url _ status conclusion _ <<<"$line"
  print_run_state "$line"
  case "$status/$conclusion" in
    completed/success)
      download_and_install_run "$id" "$sha"
      ;;
    completed/*)
      termux_abort "matching run $id failed; inspect $url. Refusing to dispatch a duplicate automatically."
      ;;
    *)
      wait_for_run "$id" "$sha"
      ;;
  esac
}

check_versions() {
  local installed_file installed_sha installed_version latest_alpha
  installed_file="$(termux_installed_metadata)"
  installed_sha="$(termux_metadata_value "$installed_file" head_sha 2>/dev/null || true)"
  installed_version="$(termux_metadata_value "$installed_file" codex_version 2>/dev/null || true)"
  printf 'Installed: %s (%s)\n' "${installed_version:-none}" "${installed_sha:-none}"
  if load_release_manifest; then
    printf 'Maintained release: %s (%s, %s)\n' "$release_tag" "$release_version" "$expected_sha"
  else
    printf 'Maintained release: not published in %s\n' "$MANIFEST_FILE"
  fi
  latest_alpha="$(git -C "$CODEX_SRC_DIR" ls-remote --tags upstream 'rust-v*-alpha.*' 2>/dev/null \
    | awk '{print $2}' | sed 's#refs/tags/##; s#\^{}##' \
    | grep -E '^rust-v[0-9]+\.[0-9]+\.[0-9]+-alpha\.[0-9]+$' | sort -V | tail -n1 || true)"
  printf 'Latest OpenAI alpha on upstream: %s\n' "${latest_alpha:-not found}"
  [[ -n "$expected_sha" && "$installed_sha" == "$expected_sha" ]]
}

termux_check_environment
case "$operation" in
  list-installed)
    termux_list_installed_releases "$PREFIX"
    exit 0
    ;;
  rollback)
    acquire_update_lock
    termux_rollback_installed_release "$PREFIX"
    "$SCRIPT_DIR/smoke-test-artifact" --installed --quick
    termux_info 'rollback complete.'
    exit 0
    ;;
  activate)
    termux_validate_sha "$expected_sha" ||       termux_abort 'activate requires --expected-sha with a full 40-character commit SHA.'
    acquire_update_lock
    termux_activate_installed_release "$PREFIX" "$expected_sha"
    "$SCRIPT_DIR/smoke-test-artifact" --installed --quick
    termux_info 'release activation complete.'
    exit 0
    ;;
esac

acquire_update_lock
prepare_checkout

case "$operation" in
  check)
    if check_versions; then
      termux_info 'installed runtime is current.'
      exit 0
    fi
    termux_info 'an install or update is needed.'
    exit 10
    ;;
  install-release)
    [[ -n "$release_tag" && -n "$expected_sha" ]] || termux_abort 'install-release requires --release-tag and --expected-sha.'
    [[ "$release_tag" =~ ^termux-v[0-9A-Za-z._-]+$ ]] || termux_abort 'invalid --release-tag.'
    termux_validate_sha "$expected_sha" || termux_abort '--expected-sha must be a full 40-character commit SHA.'
    download_public_release
    ;;
  install-run)
    [[ "$run_id" =~ ^[0-9]+$ ]] || termux_abort 'install-run requires a numeric --run-id.'
    require_gh_actions_access
    download_and_install_run "$run_id" "$expected_sha"
    ;;
  wait)
    [[ "$run_id" =~ ^[0-9]+$ ]] || termux_abort 'wait requires a numeric --run-id.'
    require_gh_actions_access
    wait_for_run "$run_id" "$expected_sha"
    ;;
  update)
    if [[ "$explicit_expected_sha" == "no" && -z "$source_ref" && "$dispatch" == "no" ]] \
      && load_release_manifest; then
      installed_sha="$(termux_metadata_value "$(termux_installed_metadata)" head_sha 2>/dev/null || true)"
      installed_root="$PREFIX/libexec/codex-termux/current"
      if [[ "$installed_sha" == "$expected_sha" ]]         && termux_installed_release_is_valid "$installed_root" "$expected_sha" "$release_version"; then
        termux_info "already current at $expected_sha"
        "$PREFIX/bin/codex" --version
        exit 0
      fi
      download_public_release
    else
      expected_sha="${expected_sha:-$(resolve_source_sha "${source_ref:-origin/main}")}"
      termux_validate_sha "$expected_sha" || termux_abort '--expected-sha must be a full 40-character commit SHA.'
      update_from_actions "$expected_sha"
    fi
    ;;
esac

"$SCRIPT_DIR/smoke-test-artifact" --installed --quick
termux_info 'update complete. Next command: codex login'
