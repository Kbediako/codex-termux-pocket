#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TERMUX_DIR="$(cd -- "$TEST_DIR/.." && pwd)"
REPO_ROOT="$(cd -- "$TERMUX_DIR/../.." && pwd)"
# shellcheck source=scripts/termux/termux-mobile-lib.sh
source "$TERMUX_DIR/termux-mobile-lib.sh"

test_root="$(mktemp -d)"
cleanup() {
  rm -rf "$test_root"
}
trap cleanup EXIT INT TERM

pass_count=0
pass() {
  printf 'ok %d - %s\n' "$((++pass_count))" "$1"
}

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

assert_eq() {
  local expected="$1"
  local actual="$2"
  local label="$3"
  [[ "$actual" == "$expected" ]] || fail "$label (expected '$expected', got '$actual')"
}

make_repo() {
  local dir="$1"
  git init -q -b main "$dir"
}

test_remote_topology() {
  local repo="$test_root/remotes"
  local fork_url="https://github.com/example/codex-termux.git"
  make_repo "$repo"
  git -C "$repo" remote add origin "$fork_url"
  termux_configure_remotes "$repo" "$fork_url"
  termux_configure_remotes "$repo" "$fork_url"
  assert_eq "$fork_url" "$(git -C "$repo" remote get-url origin)" 'origin remains the fork'
  assert_eq "$CODEX_TERMUX_UPSTREAM_URL" "$(git -C "$repo" remote get-url upstream)" 'upstream fetch URL'
  assert_eq 'DISABLED' "$(git -C "$repo" remote get-url --push upstream)" 'upstream push is disabled'
  assert_eq 'origin' "$(git -C "$repo" config remote.pushDefault)" 'fork is default push remote'
  assert_eq 'origin' "$(git -C "$repo" config branch.main.remote)" 'main pulls from fork'
  pass 'remote topology has separate fork push and OpenAI tag roles'
}

test_migrate_openai_origin() {
  local repo="$test_root/migrate"
  local fork_url="https://github.com/example/codex-termux.git"
  make_repo "$repo"
  git -C "$repo" remote add origin "$CODEX_TERMUX_UPSTREAM_URL"
  termux_configure_remotes "$repo" "$fork_url"
  assert_eq "$fork_url" "$(git -C "$repo" remote get-url origin)" 'fork origin after migration'
  assert_eq "$CODEX_TERMUX_UPSTREAM_URL" "$(git -C "$repo" remote get-url upstream)" 'OpenAI upstream after migration'
  pass 'legacy OpenAI-origin checkout migrates without commits'
}

test_valid_alpha_tag_selection() {
  local repo="$test_root/alpha-tags"
  make_repo "$repo"
  git -C "$repo" -c user.name=Test -c user.email=test@example.invalid \
    commit -q --allow-empty -m base
  git -C "$repo" tag rust-v0.148.0-alpha.4
  git -C "$repo" -c user.name=Test -c user.email=test@example.invalid \
    commit -q --allow-empty -m latest-main
  git -C "$repo" tag rust-v0.148.0-alpha.5
  git -C "$repo" tag rust-vrust-v9.0.0-alpha.99
  git -C "$repo" checkout -q --detach HEAD~1
  git -C "$repo" -c user.name=Test -c user.email=test@example.invalid \
    commit -q --allow-empty -m unmerged
  git -C "$repo" tag rust-v0.148.0-alpha.6
  assert_eq 'rust-v0.148.0-alpha.6' "$(termux_latest_valid_alpha_tag "$repo")" 'latest valid fetched alpha'
  assert_eq 'rust-v0.148.0-alpha.5' "$(termux_latest_valid_alpha_tag "$repo" main)" 'latest valid alpha merged into main'
  pass 'alpha selection ignores malformed and unmerged tags'
}

write_fake_executable() {
  local path="$1"
  local body="$2"
  mkdir -p "$(dirname "$path")"
  printf '#!/data/data/com.termux/files/usr/bin/bash\nset -euo pipefail\n%s\n' "$body" >"$path"
  chmod 0755 "$path"
}

make_bundle() {
  local dir="$1"
  local sha="$2"
  local version="$3"
  local runtime="$dir/codex-termux-runtime"
  mkdir -p "$runtime/bin" "$runtime/codex-resources"
  # shellcheck disable=SC2016 # Literal body is written into the fixture script.
  write_fake_executable "$runtime/bin/codex" 'if [[ "${1:-}" == "--version" ]]; then printf "%s\\n" "codex-cli 9.9.9"; else exit 0; fi'
  write_fake_executable "$runtime/bin/codex-code-mode-host" 'exit 0'
  write_fake_executable "$runtime/bin/codex-responses-api-proxy" 'exit 0'
  write_fake_executable "$runtime/codex-resources/bwrap" 'exit 0'
  printf '{"layoutVersion":1,"version":"%s","target":"%s"}\n' "$version" "$CODEX_TERMUX_TARGET" >"$runtime/codex-package.json"
  (
    cd "$runtime"
    find . -type f ! -path "./$CODEX_TERMUX_RUNTIME_CHECKSUMS" -print       | sed 's#^\./##' | LC_ALL=C sort       | while IFS= read -r relative; do sha256sum "$relative"; done       >"$CODEX_TERMUX_RUNTIME_CHECKSUMS"
  )
  tar -C "$dir" -czf "$dir/$CODEX_TERMUX_ARCHIVE" codex-termux-runtime
  runtime_size_bytes="$(termux_runtime_payload_bytes "$runtime")"
  archive_size_bytes="$(termux_file_size "$dir/$CODEX_TERMUX_ARCHIVE")"
  rm -rf "$runtime"
  cat >"$dir/$CODEX_TERMUX_METADATA" <<EOF
format_version=2
source_repository=example/codex-termux
head_sha=$sha
git_describe=test
codex_version=$version
target=$CODEX_TERMUX_TARGET
source_ref=$sha
archive_size_bytes=$archive_size_bytes
runtime_size_bytes=$runtime_size_bytes
EOF
  (cd "$dir" && sha256sum "$CODEX_TERMUX_ARCHIVE" "$CODEX_TERMUX_METADATA" >"$CODEX_TERMUX_CHECKSUMS")
}

test_bundle_install() {
  local bundle="$test_root/bundle"
  local prefix="$test_root/prefix"
  local bad_root
  local sha='0123456789abcdef0123456789abcdef01234567'
  local version='codex-cli 9.9.9'
  mkdir -p "$bundle" "$prefix/bin"
  make_bundle "$bundle" "$sha" "$version"
  termux_install_verified_bundle "$bundle" "$sha" "$version" '' "$prefix"
  [[ -L "$prefix/libexec/codex-termux/current" ]] || fail 'current runtime is not an atomic symlink'
  [[ -x "$prefix/libexec/codex-termux/current/bin/codex-code-mode-host" ]] || fail 'code-mode host was not installed'
  [[ -x "$prefix/libexec/codex-termux/current/codex-resources/bwrap" ]] || fail 'bundled bwrap was not installed'
  assert_eq "$version" "$(CODEX_TERMUX_DISABLE_PROOT=1 "$prefix/bin/codex" --version)" 'launcher version'
  # shellcheck disable=SC2016 # Match the literal variable in the generated launcher.
  grep -q 'export PATH="${RESOURCE_DIR}' "$prefix/bin/codex" || fail 'launcher does not expose bundled bwrap'
  termux_install_verified_bundle "$bundle" "$sha" "$version" '' "$prefix" >/dev/null
  [[ -x "$prefix/libexec/codex-termux/current/bin/codex" ]] || fail 'idempotent reinstall broke current runtime'
  printf 'corruption' >>"$prefix/libexec/codex-termux/current/bin/codex-code-mode-host"
  termux_install_verified_bundle "$bundle" "$sha" "$version" '' "$prefix" >/dev/null
  ! grep -q 'corruption' "$prefix/libexec/codex-termux/current/bin/codex-code-mode-host" ||     fail 'reinstall reused a modified installed runtime'
  compgen -G "$prefix/libexec/codex-termux/releases/${sha}.invalid.*" >/dev/null ||     fail 'modified installed runtime was not quarantined'
  pass 'complete bundle verifies, installs atomically, and repairs modified releases'

  printf 'corruption' >>"$bundle/$CODEX_TERMUX_ARCHIVE"
  if (termux_verify_download_set "$bundle" "$sha" "$version") >/dev/null 2>&1; then
    fail 'corrupt archive passed checksum verification'
  fi
  pass 'corrupt artifact is rejected before installation'

  make_bundle "$bundle" "$sha" "$version"
  if (termux_verify_download_set "$bundle" 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$version") >/dev/null 2>&1; then
    fail 'wrong artifact commit was accepted'
  fi
  pass 'artifact from a different commit is rejected'

  bad_root="$test_root/missing-sidecar"
  mkdir -p "$bad_root"
  tar -xzf "$bundle/$CODEX_TERMUX_ARCHIVE" -C "$bad_root"
  rm "$bad_root/codex-termux-runtime/bin/codex-code-mode-host"
  tar -C "$bad_root" -czf "$bundle/$CODEX_TERMUX_ARCHIVE" codex-termux-runtime
  (cd "$bundle" && sha256sum "$CODEX_TERMUX_ARCHIVE" "$CODEX_TERMUX_METADATA" >"$CODEX_TERMUX_CHECKSUMS")
  if (termux_extract_and_verify_bundle "$bundle" "$test_root/missing-sidecar-extract") >/dev/null 2>&1; then
    fail 'bundle without codex-code-mode-host was accepted'
  fi
  pass 'artifact missing a required runtime sidecar is rejected'

  make_bundle "$bundle" "$sha" "$version"
  bad_root="$test_root/symlink-entry"
  rm -rf "$bad_root"
  mkdir -p "$bad_root"
  tar -xzf "$bundle/$CODEX_TERMUX_ARCHIVE" -C "$bad_root"
  ln -s /etc/passwd "$bad_root/codex-termux-runtime/unexpected-link"
  tar -C "$bad_root" -czf "$bundle/$CODEX_TERMUX_ARCHIVE" codex-termux-runtime
  (cd "$bundle" && sha256sum "$CODEX_TERMUX_ARCHIVE" "$CODEX_TERMUX_METADATA" >"$CODEX_TERMUX_CHECKSUMS")
  if (termux_extract_and_verify_bundle "$bundle" "$test_root/symlink-entry-extract") >/dev/null 2>&1; then
    fail 'archive containing a symbolic link was accepted'
  fi
  pass 'archive links and special entries are rejected before activation'

  make_bundle "$bundle" "$sha" "$version"
  printf 'head_sha=%s\n' "$sha" >>"$bundle/$CODEX_TERMUX_METADATA"
  (cd "$bundle" && sha256sum "$CODEX_TERMUX_ARCHIVE" "$CODEX_TERMUX_METADATA" >"$CODEX_TERMUX_CHECKSUMS")
  if (termux_verify_download_set "$bundle" "$sha" "$version") >/dev/null 2>&1; then
    fail 'artifact metadata containing a duplicate key was accepted'
  fi
  pass 'duplicate and unknown metadata fields are rejected'
}

make_test_bundle_for_sha() {
  local dir="$1"
  local sha="$2"
  rm -rf "$dir"
  mkdir -p "$dir"
  make_bundle "$dir" "$sha" 'codex-cli 9.9.9'
}

test_storage_retention_and_rollback() {
  local prefix="$test_root/retention-prefix"
  local bundle="$test_root/retention-bundle"
  local sha1='1111111111111111111111111111111111111111'
  local sha2='2222222222222222222222222222222222222222'
  local sha3='3333333333333333333333333333333333333333'
  mkdir -p "$prefix/bin"

  if CODEX_TERMUX_AVAILABLE_BYTES=1 CODEX_TERMUX_INSTALL_SAFETY_BYTES=0       termux_require_install_space "$prefix" 1 1 >/dev/null 2>&1; then
    fail 'storage preflight accepted an undersized filesystem'
  fi
  CODEX_TERMUX_AVAILABLE_BYTES=1000000 CODEX_TERMUX_INSTALL_SAFETY_BYTES=0     termux_require_install_space "$prefix" 1 1 || fail 'storage preflight rejected sufficient space'
  pass 'storage preflight rejects installs before extraction when space is insufficient'

  CODEX_TERMUX_KEEP_RELEASES=2
  CODEX_TERMUX_KEEP_QUARANTINES=1
  CODEX_TERMUX_AVAILABLE_BYTES=1000000000
  CODEX_TERMUX_INSTALL_SAFETY_BYTES=0
  make_test_bundle_for_sha "$bundle" "$sha1"
  termux_install_verified_bundle "$bundle" "$sha1" 'codex-cli 9.9.9' '' "$prefix" >/dev/null
  make_test_bundle_for_sha "$bundle" "$sha2"
  termux_install_verified_bundle "$bundle" "$sha2" 'codex-cli 9.9.9' '' "$prefix" >/dev/null
  make_test_bundle_for_sha "$bundle" "$sha3"
  termux_install_verified_bundle "$bundle" "$sha3" 'codex-cli 9.9.9' '' "$prefix" >/dev/null

  [[ ! -e "$prefix/libexec/codex-termux/releases/$sha1" ]] || fail 'retention kept more releases than configured'
  assert_eq "releases/$sha3" "$(readlink "$prefix/libexec/codex-termux/current")" 'newest release activation'
  termux_rollback_installed_release "$prefix" >/dev/null
  assert_eq "releases/$sha2" "$(readlink "$prefix/libexec/codex-termux/current")" 'rollback activation'
  termux_list_installed_releases "$prefix" | grep -q "^\* $sha2" || fail 'release listing did not mark the active rollback target'
  pass 'bounded release retention preserves one verified rollback and activates it atomically'
}

test_run_dedup_and_timeout() {
  local repo="$test_root/updater-repo"
  local fake_bin="$test_root/fake-bin"
  local gh_log="$test_root/gh.log"
  local manifest="$test_root/stale-release-manifest.env"
  local output="$test_root/updater.out"
  local sha='bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
  make_repo "$repo"
  git -C "$repo" remote add origin "$CODEX_TERMUX_FORK_URL_DEFAULT"
  mkdir -p "$fake_bin"
  cat >"$manifest" <<'EOF'
format_version=1
repository=Kbediako/codex-termux-pocket
release_tag=termux-v-test-stale
head_sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
codex_version=codex-cli-stale
archive_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EOF
  cat >"$fake_bin/gh" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
printf '%s\\n' "\$*" >>'$gh_log'
case "\$1 \${2:-}" in
  'auth status') exit 0 ;;
  'run list') printf '%s\\n' \
    'https://github.com/Kbediako/codex-termux-pocket/actions/runs/31337|$sha|completed|failure|Termux runtime aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
    'https://github.com/Kbediako/codex-termux-pocket/actions/runs/4242|$sha|queued||Termux runtime $sha' ;;
  'run view') printf '%s' 'https://github.com/Kbediako/codex-termux-pocket/actions/runs/4242|$sha|queued||Termux runtime $sha' ;;
  *) exit 1 ;;
esac
EOF
  chmod 0755 "$fake_bin/gh"
  set +e
  PATH="$fake_bin:$PATH" \
    CODEX_SRC_DIR="$repo" \
    CODEX_TERMUX_SKIP_CHECKOUT_SYNC=1 \
    CODEX_TERMUX_POLL_SECONDS=1 \
    CODEX_TERMUX_LOCK_DIR="$test_root/updater.lock" \
    CODEX_TERMUX_RELEASE_MANIFEST="$manifest" \
    "$TERMUX_DIR/codex-update-alpha" update --expected-sha "$sha" --dispatch --timeout 1 >"$output" 2>&1
  status=$?
  set -e
  assert_eq '3' "$status" 'queued run local timeout status'
  grep -q 'run 4242 is queued' "$output" || fail 'queued state was not printed'
  ! grep -q 'run 31337' "$output" || fail 'a run requested for a different commit matched by branch head SHA'
  grep -q 'run URL: https://github.com/.*/4242' "$output" || fail 'timeout omitted run URL'
  grep -q 'wait --run-id 4242 --expected-sha' "$output" || fail 'timeout omitted resume command'
  if grep -q '^workflow run ' "$gh_log"; then
    fail 'a duplicate build was dispatched for an existing queued run'
  fi
  pass 'explicit commit reuses its queued run instead of a stale release or duplicate dispatch'
}

test_static_architecture_guards() {
  ! grep -q 'git .*rebase' "$TERMUX_DIR/codex-update-alpha" || fail 'end-user updater still rebases'
  ! grep -q 'git config user\.' "$TERMUX_DIR/install-codex-termux" || fail 'installer configures Git identity'
  grep -Eq 'pkg install .* nodejs([[:space:]]|$)' "$TERMUX_DIR/install-codex-termux" || fail 'installer does not install Node.js for plugin MCP servers'
  grep -q -- '--filter=blob:none' "$TERMUX_DIR/install-codex-termux" || fail 'installer does not use a filtered helper checkout'
  grep -q 'command -v node' "$TERMUX_DIR/install-codex-termux" || fail 'installer does not verify the plugin MCP runtime is available'
  grep -q 'cargo metadata --locked' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'workflow lacks lockfile gate'
  ! grep -E 'cargo metadata --locked .*--no-deps' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" "$TERMUX_DIR/maintainer-update-alpha" || fail 'lockfile gate skips target-specific dependency resolution'
  grep -q -- '--bin codex-code-mode-host' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'workflow does not build code-mode host'
  grep -q 'sha256sum --check --strict' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'workflow does not validate checksums before upload'
  grep -q 'runtime-files.sha256' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'workflow does not publish a complete runtime file manifest'
  grep -q 'rusty_v8_archive_sha256' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'workflow does not verify the pinned Rusty V8 archive'
  grep -q 'termux-control-plane' "$REPO_ROOT/.github/workflows/termux-control-plane.yml" || fail 'Termux control-plane workflow is missing'
  grep -q 'gzip -n -9' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'runtime archive is not deterministic'
  grep -q 'actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'runtime provenance action is not pinned'
  grep -q 'generate-sbom.py' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" || fail 'runtime SBOM generation is missing'
  grep -q 'rollback)' "$TERMUX_DIR/codex-update-alpha" || fail 'updater does not expose rollback'
  grep -q -- '-P :workspace' "$TERMUX_DIR/smoke-test-artifact" || fail 'installed smoke test does not exercise the restricted Android command-runner profile'
  grep -q 'command -v bwrap' "$TERMUX_DIR/smoke-test-artifact" || fail 'installed smoke test does not verify bundled bwrap discovery'
  grep -q 'unexpectedly allowed a filesystem write' "$TERMUX_DIR/smoke-test-artifact" || fail 'installed smoke test does not prove restricted write denial'
  ! grep -Eq '(^|[^[:alnum:]_])codex (sandbox|--termux-launcher-check|--version)' "$TERMUX_DIR/smoke-test-artifact" || fail 'installed smoke test can bypass the canonical launcher through inherited PATH'
  grep -q 'libc::O_PATH | libc::O_CLOEXEC' "$REPO_ROOT/codex-rs/linux-sandbox/src/landlock.rs" || fail 'Termux Landlock rules do not preserve O_PATH for Android virtual roots'
  grep -q $'subject\ttermux: preserve O_PATH for Android Landlock roots\tsecurity-critical\t' "$TERMUX_DIR/patch_audit.tsv" || fail 'Termux O_PATH security patch is missing from the patch audit'
  local lock_line build_line
  lock_line="$(grep -n 'Validate Cargo.lock before build setup' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" | cut -d: -f1)"
  build_line="$(grep -n 'Build complete Codex runtime' "$REPO_ROOT/.github/workflows/termux-mobile-artifact.yml" | cut -d: -f1)"
  (( lock_line < build_line )) || fail 'lockfile gate is not before the expensive build'
  pass 'static guards enforce artifact-first end-user and early CI lockfile validation'
}

test_remote_topology
test_migrate_openai_origin
test_valid_alpha_tag_selection
test_bundle_install
test_run_dedup_and_timeout
test_storage_retention_and_rollback
test_static_architecture_guards
printf '1..%d\n' "$pass_count"
