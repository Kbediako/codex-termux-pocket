#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/termux/termux-mobile-lib.sh
source "$SCRIPT_DIR/termux-mobile-lib.sh"

mode="installed"
bundle_dir=""
expected_sha=""
expected_version=""
quick="no"
temporary_dir=""

usage() {
  cat <<'USAGE'
Usage:
  smoke-test-artifact --installed [--quick]
  smoke-test-artifact --bundle-dir DIR --expected-sha SHA [--expected-version VERSION]

The installed test checks the launcher, metadata/version, sidecars, bundled
bubblewrap, DNS, certificates, browser handoff, permissions, and a minimal
command through the Codex command runner. --quick skips only the command
execution.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --installed)
      mode="installed"
      shift
      ;;
    --bundle-dir)
      mode="bundle"
      bundle_dir="${2:-}"
      shift 2
      ;;
    --expected-sha)
      expected_sha="${2:-}"
      shift 2
      ;;
    --expected-version)
      expected_version="${2:-}"
      shift 2
      ;;
   --quick)
      quick="yes"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      termux_abort "unknown argument: $1"
      ;;
  esac
done

cleanup() {
  if [[ -n "$temporary_dir" && -d "$temporary_dir" ]]; then
    rm -rf "$temporary_dir"
  fi
}
trap cleanup EXIT INT TERM

smoke_bundle() {
  [[ -d "$bundle_dir" ]] || termux_abort '--bundle-dir must name a directory.'
  termux_validate_sha "$expected_sha" || termux_abort '--expected-sha must be a full 40-character commit SHA.'
  termux_verify_download_set "$bundle_dir" "$expected_sha" "$expected_version"
  temporary_dir="$(mktemp -d)"
  root="$(termux_extract_and_verify_bundle "$bundle_dir" "$temporary_dir")"
  version="$("$root/bin/codex" --version)"
  termux_info "bundle smoke test passed: $version ($expected_sha)"
}

smoke_installed() {
  termux_check_environment
  local launcher metadata runtime_link runtime_root active_sha metadata_sha metadata_version actual_version token output command_status denied_path
  launcher="$PREFIX/bin/codex"
  runtime_link="$(termux_runtime_root "$PREFIX")/current"
  active_sha="$(termux_current_release_sha "$PREFIX" || true)"
  termux_validate_sha "$active_sha" || termux_abort 'current runtime link is missing or unsafe.'
  runtime_root="$(termux_runtime_root "$PREFIX")/releases/$active_sha"
  metadata="$runtime_root/$CODEX_TERMUX_METADATA"

  [[ -L "$runtime_link" ]] || termux_abort "current runtime link is missing: $runtime_link"
  [[ -d "$runtime_root" && ! -L "$runtime_root" ]] || \
    termux_abort "active runtime directory is missing or unsafe: $runtime_root"
  [[ -f "$metadata" && ! -L "$metadata" ]] || termux_abort "installed metadata is missing or unsafe: $metadata"
  metadata_sha="$(termux_metadata_value "$metadata" head_sha)"
  metadata_version="$(termux_metadata_value "$metadata" codex_version)"
  termux_validate_sha "$metadata_sha" || termux_abort 'installed metadata has an invalid commit SHA.'
  [[ "$metadata_sha" == "$active_sha" ]] || \
    termux_abort "active runtime link points to $active_sha but metadata names $metadata_sha."

  [[ -x "$launcher" ]] || termux_abort "launcher is missing or not executable: $launcher"
  [[ -x "$runtime_root/bin/codex" ]] || termux_abort 'installed Codex runtime is missing.'
  [[ -x "$runtime_root/bin/codex-code-mode-host" ]] || termux_abort 'installed codex-code-mode-host is missing.'
  [[ -x "$runtime_root/bin/codex-responses-api-proxy" ]] || termux_abort 'installed codex-responses-api-proxy is missing.'
  [[ -x "$runtime_root/codex-resources/bwrap" ]] || termux_abort 'verified bundled bubblewrap is missing.'
  [[ ! -w "$runtime_root/bin/codex" || -O "$runtime_root/bin/codex" ]] || termux_abort 'runtime permissions/ownership are unsafe.'
  termux_installed_release_is_valid "$runtime_root" "$metadata_sha" "$metadata_version" || \
    termux_abort 'installed runtime tree failed integrity validation.'

  actual_version="$("$launcher" --version)"
  [[ "$actual_version" == "$metadata_version" ]] || \
    termux_abort "installed version mismatch: metadata says $metadata_version, launcher says $actual_version."
  "$runtime_root/bin/codex-code-mode-host" --help >/dev/null
  "$runtime_root/bin/codex-responses-api-proxy" --help >/dev/null
  "$runtime_root/codex-resources/bwrap" --version >/dev/null
  "$launcher" --termux-launcher-check >/dev/null

  if [[ "$quick" != "yes" ]]; then
    SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem" \
      curl --silent --show-error --connect-timeout 15 --max-time 30 --head \
      https://api.openai.com/ >/dev/null
    token="codex-termux-command-ok-$$"
    set +e
    output="$("$launcher" sandbox -P :workspace -- "$PREFIX/bin/bash" -c \
      "printf 'bwrap=%s\\n' \"\$(command -v bwrap)\"; bwrap --version; printf '%s' '$token'" 2>&1)"
    command_status=$?
    set -e
    if (( command_status != 0 )); then
      printf '%s\n' "$output" >&2
      termux_abort "minimal command failed in the Codex Termux command runner (exit $command_status)."
    fi
    [[ "$output" != *'Codex could not find bubblewrap on PATH'* ]] || \
      termux_abort 'bundled bubblewrap was not discovered on PATH.'
    [[ "$output" == *"bwrap=$runtime_link/codex-resources/bwrap"* ]] || \
      termux_abort 'command runner did not resolve the verified bundled bubblewrap.'
    [[ "$output" == *"$token"* ]] || termux_abort 'minimal command did not cross the Codex Termux sandbox runner.'

    denied_path="${TMPDIR:-$PREFIX/tmp}/codex-termux-sandbox-deny-$$"
    if "$launcher" sandbox -P :workspace -- "$PREFIX/bin/bash" -c \
      "printf forbidden >'$denied_path'" >/dev/null 2>&1; then
      termux_abort 'restricted Termux fallback unexpectedly allowed a filesystem write.'
    fi
    [[ ! -e "$denied_path" ]] || {
      rm -f "$denied_path"
      termux_abort 'restricted Termux fallback created a file outside an approved execution.'
    }
  fi

  termux_info "installed smoke test passed: $actual_version ($metadata_sha)"
  if [[ "$quick" != "yes" ]]; then
    termux_info 'launcher DNS/CA/browser checks and restricted Landlock/seccommp command smoke test passed.'
  fi
}

case "$mode" in
  bundle) smoke_bundle ;;
  installed) smoke_installed ;;
esac
