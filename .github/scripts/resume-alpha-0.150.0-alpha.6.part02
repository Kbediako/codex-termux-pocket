
CURRENT_STEP="verifying-current-alpha-source"
issue_update running "$CURRENT_STEP"
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
local_head="$(git rev-parse HEAD)"
remote_main="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
if [[ "$local_head" != "$remote_main" ]]; then
  echo "::error::checked-out HEAD ${local_head} does not equal protected main ${remote_main}" >&2
  exit 1
fi
if git remote get-url upstream >/dev/null 2>&1; then
  git remote set-url upstream https://github.com/openai/codex.git
else
  git remote add upstream https://github.com/openai/codex.git
fi
git fetch --no-tags upstream "refs/tags/${UPSTREAM_TAG}:refs/tags/${UPSTREAM_TAG}"
[[ "$(git rev-parse "${UPSTREAM_TAG}^{commit}")" == "$UPSTREAM_COMMIT" ]]
[[ "$(git ls-remote upstream refs/heads/latest-alpha-cli | awk '{print $1}')" == "$UPSTREAM_COMMIT" ]]
git merge-base --is-ancestor "$UPSTREAM_COMMIT" HEAD
workspace_version="$(
  awk '
    /^\[workspace\.package\]$/ { in_package=1; next }
    /^\[/ && in_package { exit }
    in_package && /^version[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=[[:space:]]*"/, "", value)
      sub(/".*$/, "", value)
      print value
      exit
    }
  ' codex-rs/Cargo.toml
)"
[[ "$workspace_version" == "$PACKAGE_VERSION" ]]

CURRENT_STEP="verifying-and-committing-lockfile-if-needed"
issue_update running "$CURRENT_STEP"
cargo metadata --manifest-path codex-rs/Cargo.toml --format-version=1 >/dev/null
cargo metadata --manifest-path codex-rs/Cargo.toml --locked --format-version=1 >/dev/null
grep -F 'version = "0.150.0-alpha.6"' codex-rs/Cargo.lock >/dev/null
mapfile -t changed < <(git status --porcelain | cut -c4-)
if (( ${#changed[@]} == 0 )); then
  LOCK_SHA="$(git rev-parse HEAD)"
elif (( ${#changed[@]} == 1 )) && [[ "${changed[0]}" == "codex-rs/Cargo.lock" ]]; then
  git diff --check
  git add codex-rs/Cargo.lock
  git commit -m "termux: update to ${PACKAGE_VERSION}"
  LOCK_SHA="$(git rev-parse HEAD)"
  git push origin HEAD:main
else
  printf 'Unexpected files changed while verifying Cargo.lock:\n' >&2
  printf '  %s\n' "${changed[@]}" >&2
  exit 1
fi
git push origin "HEAD:refs/heads/${STAGING_BRANCH}"
issue_update awaiting-direct-cleanup "lockfile-verified:${LOCK_SHA}"

CURRENT_STEP="waiting-for-permanent-source-cleanup"
cleaned=false
for _ in $(seq 1 180); do
  git fetch origin main
  git reset --hard origin/main
  if ! compgen -G "$TEMP_PART_GLOB" >/dev/null \
    && ! grep -q 'resume-alpha-0.150.0-alpha.6' .github/workflows/blocking-ci.yml \
    && ! grep -q 'update-latest-alpha:' .github/workflows/blocking-ci.yml; then
    python3 .github/scripts/validate-termux-workflow-topology.py
    cargo metadata --manifest-path codex-rs/Cargo.toml --locked --format-version=1 >/dev/null
    [[ -z "$(git status --porcelain)" ]]
    SOURCE_SHA="$(git rev-parse HEAD)"
    git merge-base --is-ancestor "$UPSTREAM_COMMIT" "$SOURCE_SHA"
    cleaned=true
    break
